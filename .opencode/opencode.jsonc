{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-skills"],
  "provider": {
    "opencode": {
      "options": {}
    }
  },
  "mcp": {
    "morph": {
      "type": "local",
      "command": ["bunx", "@morphllm/morphmcp"],
      "environment": {
        "ENABLED_TOOLS": "warpgrep_codebase_search,edit_file"
      }
    }
  }
}
